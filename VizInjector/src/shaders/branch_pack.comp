#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer InLinearBuffer {
    vec4 lin_img[];
};

layout(std430, set = 0, binding = 1) writeonly buffer OutPlanarBuffer {
    float out_planar[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint mode;
} pc;

float linear_to_srgb(float c) {
    float v = clamp(c, 0.0, 1.0);
    if (v <= 0.0031308) {
        return v * 12.92;
    }
    return 1.055 * pow(v, 1.0 / 2.4) - 0.055;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    if (pc.mode == 2u || pc.mode == 4u) {
        uint lat_w = pc.width / 16u;
        uint lat_h = pc.height / 16u;
        if (x >= lat_w || y >= lat_h) {
            return;
        }
        bool use_red = (pc.mode == 4u);
        float sum_v = 0.0;
        float max_v = 0.0;
        for (uint dy = 0u; dy < 16u; ++dy) {
            uint row_base = (y * 16u + dy) * pc.width + x * 16u;
            for (uint dx = 0u; dx < 16u; ++dx) {
                vec4 px = lin_img[row_base + dx];
                float v = clamp(use_red ? px.r : px.a, 0.0, 1.0);
                sum_v += v;
                max_v = max(max_v, v);
            }
        }
        float avg = sum_v * (1.0 / 256.0);
        if (avg > 0.01 && avg < 0.25 && max_v > 0.75) {
            avg = 0.65 * avg + 0.35 * max_v;
        }
        out_planar[y * lat_w + x] = clamp(avg, 0.0, 1.0);
        return;
    }

    if (x >= pc.width || y >= pc.height) {
        return;
    }

    uint plane = pc.width * pc.height;
    uint idx = y * pc.width + x;
    vec4 lin = lin_img[idx];

    if (pc.mode == 3u) {
        float luma = 0.2126 * lin.r + 0.7152 * lin.g + 0.0722 * lin.b;
        float d_val = clamp(fma(luma, 2.0, -1.0), -1.0, 1.0);
        out_planar[0u * plane + idx] = d_val;
        out_planar[1u * plane + idx] = d_val;
        out_planar[2u * plane + idx] = d_val;
        return;
    }

    vec3 srgb = vec3(
        clamp(linear_to_srgb(lin.r), 0.0, 1.0),
        clamp(linear_to_srgb(lin.g), 0.0, 1.0),
        clamp(linear_to_srgb(lin.b), 0.0, 1.0)
    );
    vec3 norm_rgb = fma(srgb, vec3(2.0), vec3(-1.0));

    if (pc.mode == 0u) {
        out_planar[0u * plane + idx] = norm_rgb.r;
        out_planar[1u * plane + idx] = norm_rgb.g;
        out_planar[2u * plane + idx] = norm_rgb.b;
    } else {
        uint grid_w = pc.width / 16u;
        uint merge = 2u;
        uint gh_m = (y / 16u) / merge;
        uint m_y = (y / 16u) % merge;
        uint py = y % 16u;

        uint gw_m = (x / 16u) / merge;
        uint m_x = (x / 16u) % merge;
        uint px = x % 16u;

        uint patch_idx = ((gh_m * (grid_w / merge) + gw_m) * merge + m_y) * merge + m_x;
        uint spatial_offset = py * 16u + px;
        uint patch_stride = 3u * 2u * 256u;
        uint base_out = patch_idx * patch_stride;

        out_planar[base_out + (0u * 2u + 0u) * 256u + spatial_offset] = norm_rgb.r;
        out_planar[base_out + (0u * 2u + 1u) * 256u + spatial_offset] = norm_rgb.r;
        out_planar[base_out + (1u * 2u + 0u) * 256u + spatial_offset] = norm_rgb.g;
        out_planar[base_out + (1u * 2u + 1u) * 256u + spatial_offset] = norm_rgb.g;
        out_planar[base_out + (2u * 2u + 0u) * 256u + spatial_offset] = norm_rgb.b;
        out_planar[base_out + (2u * 2u + 1u) * 256u + spatial_offset] = norm_rgb.b;
    }
}