#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer InRawBuffer {
    uint raw_rgba[];
};

layout(std430, set = 0, binding = 1) writeonly buffer OutLinearBuffer {
    vec4 linear_rgba[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint deband_8bit;
    uint seed;
} pc;

float srgb_to_linear(float c) {
    float v = clamp(c, 0.0, 1.0);
    if (v <= 0.04045) {
        return v * (1.0 / 12.92);
    }
    return pow((v + 0.055) * (1.0 / 1.055), 2.4);
}

vec4 unpack_rgba8(uint packed_px) {
    return vec4(
        float((packed_px >> 0u) & 0xFFu) * (1.0 / 255.0),
        float((packed_px >> 8u) & 0xFFu) * (1.0 / 255.0),
        float((packed_px >> 16u) & 0xFFu) * (1.0 / 255.0),
        float((packed_px >> 24u) & 0xFFu) * (1.0 / 255.0)
    );
}

uint hash_u32(uint x) {
    x = (x ^ 61u) ^ (x >> 16u);
    x *= 9u;
    x = x ^ (x >> 4u);
    x *= 0x27D4EB2Du;
    x = x ^ (x >> 15u);
    return x;
}

float hash_tpdf(uvec2 p, uint ch, uint seed) {
    uint n1 = hash_u32(p.x * 0x1F123BB5u + p.y * 0x05491333u + ch * 0x9E3779B9u + seed);
    uint n2 = hash_u32(n1 * 0x85EBCA6Bu + 0xC2B2AE35u);
    float u1 = float(n1 & 0xFFFFu) * (1.0 / 65535.0);
    float u2 = float(n2 & 0xFFFFu) * (1.0 / 65535.0);
    return (u1 - u2) * (0.5 / 255.0);
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) {
        return;
    }

    uint idx = y * pc.width + x;
    vec4 px = unpack_rgba8(raw_rgba[idx]);

    if (pc.deband_8bit == 2u) {
        linear_rgba[idx] = px;
        return;
    }

    if (px.a <= (1.0 / 255.0)) {
        vec3 acc_lin = vec3(0.0);
        float acc_w = 0.0;
        int y0 = max(0, int(y) - 2);
        int y1 = min(int(pc.height) - 1, int(y) + 2);
        int x0 = max(0, int(x) - 2);
        int x1 = min(int(pc.width) - 1, int(x) + 2);

        for (int ny = y0; ny <= y1; ++ny) {
            int ady = abs(ny - int(y));
            uint row_off = uint(ny) * pc.width;
            for (int nx = x0; nx <= x1; ++nx) {
                vec4 np = unpack_rgba8(raw_rgba[row_off + uint(nx)]);
                if (np.a > (1.0 / 255.0)) {
                    int dist = max(1, abs(nx - int(x)) + ady);
                    float w = np.a / float(dist);
                    acc_lin += vec3(
                        srgb_to_linear(np.r),
                        srgb_to_linear(np.g),
                        srgb_to_linear(np.b)
                    ) * w;
                    acc_w += w;
                }
            }
        }

        vec3 out_lin = (acc_w > 1e-6) ? (acc_lin / acc_w) : vec3(0.0);
        linear_rgba[idx] = vec4(out_lin, 0.0);
        return;
    }

    if (pc.deband_8bit != 0u) {
        uint rx = min(x + 1u, pc.width - 1u);
        uint by = min(y + 1u, pc.height - 1u);
        vec4 px_r = unpack_rgba8(raw_rgba[y * pc.width + rx]);
        vec4 px_b = unpack_rgba8(raw_rgba[by * pc.width + x]);
        float grad = max(length(px.rgb - px_r.rgb), length(px.rgb - px_b.rgb));
        float gate = clamp(1.0 - (grad * 16.0), 0.0, 1.0);
        if (gate > 0.0) {
            px.r = clamp(px.r + hash_tpdf(uvec2(x, y), 0u, pc.seed) * gate, 0.0, 1.0);
            px.g = clamp(px.g + hash_tpdf(uvec2(x, y), 1u, pc.seed) * gate, 0.0, 1.0);
            px.b = clamp(px.b + hash_tpdf(uvec2(x, y), 2u, pc.seed) * gate, 0.0, 1.0);
        }
    }

    vec3 lin = vec3(
        srgb_to_linear(px.r),
        srgb_to_linear(px.g),
        srgb_to_linear(px.b)
    );
    linear_rgba[idx] = vec4(lin, px.a);
}